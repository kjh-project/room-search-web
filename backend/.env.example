PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jachwi
# 준희(SFR-001)가 JWT를 발급할 때 쓰는 값과 반드시 동일해야 함
JWT_SECRET=change-me
# 카카오 developers > 내 애플리케이션 > REST API 키 (서버 전용, 클라이언트 노출 금지)
KAKAO_REST_API_KEY=

# ---- SFR-001 소셜 로그인 (준희) ----
JWT_EXPIRES_IN=2h
# 카카오 로그인 > 보안 > Client Secret 을 "사용함"으로 했을 때만
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 카카오·구글 콘솔에 등록한 Redirect URI 와 똑같이 (쉼표 구분)
ALLOWED_REDIRECT_URIS=http://localhost:5173/oauth/kakao,http://localhost:5173/oauth/google
