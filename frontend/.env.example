# .env 로 복사해서 값 채우기 (.env 는 git 에 올리지 말 것)

# true(또는 생략)면 서버 없이 목업 데이터로 화면 확인. 종환 님 서버에 붙일 때 false
VITE_USE_MOCK=true

# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키
VITE_KAKAO_JS_KEY=여기에_JavaScript_키
VITE_KAKAO_REST_KEY=여기에_REST_API_키

# Google Cloud Console > OAuth 클라이언트 ID (웹)
VITE_GOOGLE_CLIENT_ID=여기에_구글_클라이언트_ID

# 지도 첫 화면 중심 (기본: 동의대학교)
VITE_DEFAULT_LAT=35.1446
VITE_DEFAULT_LNG=129.0343
